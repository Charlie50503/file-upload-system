{
  "name": "file-management-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration=production && npm run copy-404",
    "buildUat": "ng build --configuration=uat --base-href /",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \"src/**/*\"",
    "clean:api": "del-cli --force src/app/api/v*",
    "apigen:v1": "ng-openapi-gen --input http://localhost:3200/api-json --output src/app/api/v1",
    "apigen": "npm run clean:api & npm run apigen:v1",
    "copy-404": "cp dist/browser/index.html dist/browser/404.html"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@auth0/angular-jwt": "^5.2.0",
    "ngx-spinner": "^16.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@types/body-parser": "^1.19.5",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.16",
    "del-cli": "^5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-openapi-gen": "^0.51.0",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "tailwindcss": "^3.3.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "node-forge": "^1.4.3"
  }
}
